GITHUB_TOKEN=            # classic PAT, no scopes needed (public data)
DATABASE_URL=            # Neon POOLED connection string (host has -pooler)
STARS_MIN=100
POLL_INTERVAL_SECONDS=180
BACKFILL_HOURS=24
LANGUAGES=javascript,typescript,python,go,rust,java
LABEL_FILTER=            # optional CSV, e.g. good first issue,help wanted
FEED_PAGE_SIZE=50
PORT=3000               # read API port (npm run api)
POLL_TRIGGER_TOKEN=     # optional shared secret; enables POST /internal/poll for external cron pingers
ENRICH_MAX_ISSUES=500   # max issues re-verified per enrich pass
RETENTION_DAYS=2        # issues older than this leave the feed
# Postgres write cadence. Reads are served from memory, so these knobs are the
# whole database workload. Neon autosuspends after 5 idle minutes and bills for
# time awake, so each flush costs ~5 minutes no matter how small the batch:
# 30 min -> ~32 CU-hrs/month, 60 min -> ~16, against a 100 CU-hr free allowance.
DB_FLUSH_MINUTES=30
ENRICH_INTERVAL_MINUTES=360   # re-verify claimability (GitHub only; no extra wake)
SNAPSHOT_RELOAD_MINUTES=360   # re-sync memory from Postgres, folded into a flush
